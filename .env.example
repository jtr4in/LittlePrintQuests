# Your bot's public address, no trailing slash (Railway: Settings > Networking > Generate Domain)
PUBLIC_URL=https://your-bot.up.railway.app
# Password for the dashboard (any username works)
ADMIN_PASSWORD=
# From etsy.com/developers > Your Apps (leave empty to run without Etsy)
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# From console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: only treat these listing ids as custom orders (comma separated)
CUSTOM_LISTING_IDS=
# Optional: phone alerts through the free ntfy app; pick a long random topic name
NTFY_TOPIC=
# Optional: minutes between Etsy checks (default 5)
POLL_MINUTES=5

# ----- Website orders (Stripe + email). Leave empty to turn website checkout off. -----
# Stripe dashboard > Developers > API keys (use sk_test_... until you're ready)
STRIPE_SECRET_KEY=
# Stripe dashboard > Developers > Webhooks, after adding <PUBLIC_URL>/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Price of a custom hunt in cents (default 999 = $9.99)
PRICE_CENTS=999
# Your website's address, where "back" on the Stripe page returns to
SITE_URL=https://jtr4in.github.io/LittlePrintQuests/
# Optional: only let this site start checkouts (default: any)
SITE_ORIGIN=https://jtr4in.github.io
# From resend.com > API Keys
RESEND_API_KEY=
# Sender address on a domain you verified in Resend
EMAIL_FROM=LittlePrintQuests <hunts@yourdomain.com>
# Optional: where buyer replies go
EMAIL_REPLY_TO=
